FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS node-runtime
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS native-base
ENV DEBIAN_FRONTEND=noninteractive UV_CONCURRENT_BUILDS=1 UV_CONCURRENT_INSTALLS=1 UV_CONCURRENT_DOWNLOADS=4 \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python UV_PYTHON_PREFERENCE=only-managed \
    UV_PYTHON=/opt/uv-python/cpython-3.12.11-linux-x86_64-gnu/bin/python3.12 \
    NODE_OPTIONS=--max-old-space-size=768 npm_config_audit=false npm_config_fund=false \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
COPY --from=node-runtime /usr/local/ /usr/local/
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git postgresql-client libglib2.0-0 libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libdbus-1-3 libatspi2.0-0 libx11-6 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
    libxrandr2 libgbm1 libxcb1 libxkbcommon0 libpango-1.0-0 libcairo2 libasound2 \
    && rm -rf /var/lib/apt/lists/*
COPY benchmarks/toolathlon-gym/uv.lock.requirements /tmp/uv.requirements
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r /tmp/uv.requirements \
    && uv python install 3.12.11
COPY --from=native-source pyproject.toml uv.lock /opt/native-root/
RUN UV_PROJECT_ENVIRONMENT=/opt/venv uv sync --frozen --no-dev --no-install-project --project /opt/native-root --python "$UV_PYTHON"
ENV PATH=/opt/venv/bin:$PATH
COPY --from=native-source local_servers/ /opt/local_servers/
COPY --from=native-source configs/mcp_servers/ /opt/native-mcp-configs/
COPY benchmarks/toolathlon-gym/patches/ /opt/native-build-patches/
COPY benchmarks/toolathlon-gym/tools/patch_mcp.py /opt/patch-mcp.py
RUN python /opt/patch-mcp.py
COPY benchmarks/toolathlon-gym/tools/build_mcp.py /opt/build-mcp.py
FROM native-base AS native-locks
COPY benchmarks/toolathlon-gym/locks/ /opt/local_servers/
ARG NATIVE_LOCK_MODE=frozen
RUN --mount=type=cache,id=evalhive-toolathlon-uv,target=/root/.cache/uv \
    --mount=type=cache,id=evalhive-toolathlon-npm,target=/root/.npm \
    EVALHIVE_NATIVE_LOCK_MODE="$NATIVE_LOCK_MODE" python /opt/build-mcp.py resolve
FROM native-locks AS native-installed
RUN --mount=type=cache,id=evalhive-toolathlon-uv,target=/root/.cache/uv \
    --mount=type=cache,id=evalhive-toolathlon-npm,target=/root/.npm \
    python /opt/build-mcp.py install
FROM native-installed AS native-built
ARG MCP_BUILD_NODE_OPTIONS=--max-old-space-size=1536
RUN NODE_OPTIONS="$MCP_BUILD_NODE_OPTIONS" python /opt/build-mcp.py build --project 12306-mcp
RUN NODE_OPTIONS="$MCP_BUILD_NODE_OPTIONS" python /opt/build-mcp.py build --project Calendar-Autoauth-MCP-Server
RUN NODE_OPTIONS="$MCP_BUILD_NODE_OPTIONS" python /opt/build-mcp.py build --project HowToCook-mcp
RUN NODE_OPTIONS="$MCP_BUILD_NODE_OPTIONS" python /opt/build-mcp.py build --project filesystem
RUN NODE_OPTIONS="$MCP_BUILD_NODE_OPTIONS" python /opt/build-mcp.py build --project google-forms-mcp
RUN NODE_OPTIONS="$MCP_BUILD_NODE_OPTIONS" python /opt/build-mcp.py build --project mcp-canvas-lms
RUN NODE_OPTIONS="$MCP_BUILD_NODE_OPTIONS" python /opt/build-mcp.py build --project mcp-npx-fetch
RUN NODE_OPTIONS="$MCP_BUILD_NODE_OPTIONS" python /opt/build-mcp.py build --project notion-mcp-server
RUN NODE_OPTIONS="$MCP_BUILD_NODE_OPTIONS" python /opt/build-mcp.py build --project playwright-mcp
RUN NODE_OPTIONS="$MCP_BUILD_NODE_OPTIONS" python /opt/build-mcp.py build --project memory
RUN NODE_OPTIONS="$MCP_BUILD_NODE_OPTIONS" python /opt/build-mcp.py build --project woocommerce-mcp
RUN NODE_OPTIONS="$MCP_BUILD_NODE_OPTIONS" python /opt/build-mcp.py build --project youtube-mcp-server
RUN python /opt/build-mcp.py verify
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
RUN node /opt/local_servers/playwright-mcp/node_modules/playwright/cli.js install chromium
COPY benchmarks/toolathlon-gym/src/evalhive_toolathlon/environment.py /opt/evalhive-toolathlon/environment.py
RUN dpkg-query --show > /opt/build-info/debian-packages.lock \
    && /opt/venv/bin/python --version > /opt/build-info/python.txt \
    && node --version > /opt/build-info/node.txt
WORKDIR /workspace
ENTRYPOINT []
CMD ["/opt/venv/bin/python", "-c", "import time;time.sleep(86400)"]
