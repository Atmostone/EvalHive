{
  "protocol_version": "1.0",
  "kind": "benchmark",
  "id": "harbor",
  "version": "0.1.0",
  "display_name": "Harbor / Terminal-Bench",
  "entrypoint": [
    "python",
    "-m",
    "evalhive_harbor.worker"
  ],
  "image": "evalhive-benchmark-harbor:0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "evaluation_mode": {
        "enum": [
          "native",
          "deferred"
        ],
        "default": "native"
      },
      "prepare_timeout_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600,
        "default": 120
      }
    },
    "additionalProperties": false
  },
  "secret_schema": {
    "type": "object",
    "additionalProperties": false
  },
  "capabilities": {
    "prepare": "native",
    "drive": "native",
    "capture": "native",
    "evaluate": "native",
    "aggregate": "native",
    "cleanup": "native",
    "regrade": "native"
  },
  "requirements": {
    "capabilities": [
      "host.agent_api_v1",
      "host.rootless_storage_v1",
      "host.exec_deadline_inheritance_v1"
    ],
    "platform": {
      "os": "linux",
      "architecture": "amd64",
      "libc": "glibc"
    },
    "resources": {
      "memory_mb": 512,
      "cpu_cores": 0.2,
      "disk_mb": 1152
    }
  }
}
