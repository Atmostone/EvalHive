{
  "protocol_version": "1.0",
  "kind": "benchmark",
  "id": "mcpmark",
  "version": "0.1.0",
  "display_name": "MCPMark Verified",
  "entrypoint": ["python", "-m", "evalhive_mcpmark.worker"],
  "image": "evalhive-benchmark-mcpmark:0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "evaluation_mode": {"enum": ["native", "deferred"], "default": "native"},
      "prepare_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1200, "default": 120}
    },
    "additionalProperties": false
  },
  "secret_schema": {"type": "object", "properties": {"service_credentials": {"type": "string"}}, "additionalProperties": false},
  "capabilities": {
    "prepare": "native", "drive": "native", "capture": "native",
    "evaluate": "native", "aggregate": "unsupported", "cleanup": "native",
    "regrade": "unsupported"
  },
  "requirements": {
    "capabilities": ["host.rootless_storage_v1", "host.ephemeral_exec_v1", "host.exec_deadline_inheritance_v1", "host.model_gateway_v1"],
    "platform": {"os": "linux", "architecture": "amd64", "libc": "glibc"},
    "resources": {"memory_mb": 256, "cpu_cores": 0.25, "disk_mb": 256}
  }
}
