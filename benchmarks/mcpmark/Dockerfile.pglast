# Rebuild the unavailable upstream 7.2 wheel from its exact official source tag.
FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS builder
RUN rm -f /etc/apt/sources.list.d/* && printf '%s\n' \
    'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261001T000000Z bookworm main' \
    > /etc/apt/sources.list && apt-get update && apt-get install -y --no-install-recommends gcc make libc6-dev \
    && rm -rf /var/lib/apt/lists/*
COPY benchmarks/mcpmark/pglast-build.lock /tmp/build.lock
RUN --mount=from=build_wheels,target=/build-wheels,readonly \
    pip install --no-index --find-links=/build-wheels --no-deps --require-hashes -r /tmp/build.lock
COPY --from=pglast_source / /build/pglast/
COPY benchmarks/mcpmark/pglast-source.lock.json /tmp/source.lock.json
WORKDIR /build/pglast
RUN python - <<'PY'
import hashlib, json
from pathlib import Path
root = Path.cwd()
files = []
for path in sorted(root.rglob('*')):
    if path.is_symlink():
        assert path.resolve(strict=True).is_relative_to(root), 'Native parser link leaves its source root'
        files.append({'path': path.relative_to(root).as_posix(), 'kind': 'symlink', 'target': str(path.readlink())})
    elif path.is_file():
        data = path.read_bytes()
        files.append({'path': path.relative_to(root).as_posix(), 'size_bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()})
assert files == json.loads(Path('/tmp/source.lock.json').read_text())['files'], 'Native parser source changed'
PY
ENV SOURCE_DATE_EPOCH=1734768637 MAKEFLAGS=-j1 CFLAGS="-ffile-prefix-map=/build=/native-build"
RUN --network=none python setup.py bdist_wheel --dist-dir=/wheels

FROM scratch AS artifact
COPY --from=builder /wheels/ /
