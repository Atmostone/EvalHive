FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS clients
WORKDIR /opt/mcp-clients
COPY benchmarks/mcpmark/clients/package.json benchmarks/mcpmark/clients/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund --registry=https://registry.npmjs.org

FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
COPY --from=clients /usr/local/bin/node /usr/local/bin/node
COPY --from=clients /opt/mcp-clients /opt/mcp-clients
COPY benchmarks/mcpmark/src/evalhive_mcpmark/task_client.py /opt/environment/task_client.py
COPY benchmarks/mcpmark/postgres-client-requirements.lock /tmp/postgres-client.lock
RUN --mount=from=postgres_wheels,target=/wheels,readonly \
    python -m venv /opt/postgres-client \
    && /opt/postgres-client/bin/pip install --no-index --find-links=/wheels --no-deps --require-hashes -r /tmp/postgres-client.lock \
    && /opt/postgres-client/bin/pip check
RUN --network=none /opt/postgres-client/bin/python -c "import pglast; assert pglast.parse_sql('SELECT 1')" \
    && /opt/postgres-client/bin/postgres-mcp --help
RUN mkdir /workspace && chmod 0777 /workspace
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
USER 1000:1000
ENTRYPOINT []
CMD ["python", "-c", "import time; time.sleep(86400)"]
