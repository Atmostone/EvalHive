{
  "protocol_version": "1.0",
  "kind": "benchmark",
  "id": "tau2",
  "version": "0.1.0",
  "display_name": "tau2-bench half-duplex",
  "entrypoint": ["python", "-m", "evalhive_tau2.worker"],
  "image": "evalhive-benchmark-tau2:0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "max_steps": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 200},
      "max_errors": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 10},
      "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647, "default": 300},
      "enforce_communication_protocol": {"type": "boolean", "default": false},
      "evaluation_mode": {"enum": ["native", "deferred"], "default": "native"},
      "prepare_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600, "default": 120}
    },
    "additionalProperties": false
  },
  "secret_schema": {"type": "object", "additionalProperties": false},
  "capabilities": {
    "prepare": "native", "drive": "native", "capture": "native",
    "evaluate": "native", "aggregate": "unsupported", "cleanup": "native",
    "regrade": "native", "interaction.external_steps": "emulated"
  },
  "requirements": {
    "capabilities": ["host.rootless_storage_v1", "host.ephemeral_exec_v1", "host.exec_deadline_inheritance_v1"],
    "platform": {"os": "linux", "architecture": "amd64", "libc": "glibc"},
    "resources": {"memory_mb": 768, "cpu_cores": 0.5, "disk_mb": 512}
  }
}
