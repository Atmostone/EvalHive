FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
RUN mkdir -p /workspace \
    && chmod 1777 /workspace \
    && printf 'Native image input\n' > /workspace/result.txt \
    && chmod 666 /workspace/result.txt
WORKDIR /workspace
USER 1000
HEALTHCHECK --interval=2s --timeout=10s --start-period=60s --retries=3 \
    CMD ["python", "-c", "from urllib.request import urlopen; urlopen('http://127.0.0.1:8768/sidecar.txt', timeout=1).read(1)"]
ENTRYPOINT []
CMD ["python", "-m", "http.server", "8768"]
