{
  "manifest": {
    "protocol_version": "1.0",
    "id": "example.fake",
    "version": "0.1.0",
    "display_name": "External fake connector",
    "entrypoint": [
      "python",
      "connector.py"
    ],
    "image": "evalhive-fake:0.1.0",
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "prefix": {
          "type": "string"
        },
        "wait": {
          "type": "boolean"
        },
        "fail": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "feedback": "native",
      "abort": "native",
      "approval": "unsupported",
      "conversation": "native",
      "external_tool_execution": "emulated",
      "turn.submit": "native",
      "tool.respond": "native",
      "session.close": "native"
    },
    "commands": {
      "feedback": {
        "input_schema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        }
      },
      "abort": {
        "input_schema": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "turn.submit": {
        "input_schema": {
          "type": "object",
          "properties": {
            "input_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "turn_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "messages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "user"
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 262144
                  }
                },
                "required": [
                  "role",
                  "content"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "input_id",
            "turn_id",
            "expected_revision",
            "messages"
          ],
          "additionalProperties": false
        }
      },
      "tool.respond": {
        "input_schema": {
          "type": "object",
          "properties": {
            "input_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "turn_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "batch_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "results": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/conversation_tool_result"
              }
            }
          },
          "required": [
            "input_id",
            "turn_id",
            "batch_id",
            "expected_revision",
            "results"
          ],
          "additionalProperties": false,
          "$defs": {
            "conversation_tool_result": {
              "type": "object",
              "properties": {
                "call_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "content": {},
                "is_error": {
                  "type": "boolean"
                }
              },
              "required": [
                "call_id",
                "content",
                "is_error"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "session.close": {
        "input_schema": {
          "type": "object",
          "properties": {
            "input_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reason": {
              "type": "string",
              "maxLength": 262144
            }
          },
          "required": [
            "input_id",
            "expected_revision",
            "reason"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "spec": {
    "protocol_version": "1.0",
    "task_id": "task-1",
    "attempt_id": "attempt-1",
    "workspace_id": "workspace-1",
    "task": {
      "prompt": "Write a file"
    },
    "cwd": "/workspace",
    "instructions": [
      "Do the task"
    ],
    "config": {
      "prefix": "Hello\u2028world\u2029\ud83c\udf0d"
    },
    "model": null,
    "credential_refs": {},
    "environment": {
      "id": "plain",
      "resources": []
    },
    "limits": {
      "wall_time_seconds": 30,
      "cpu_cores": 1,
      "memory_mb": 128
    },
    "required_capabilities": [
      "feedback"
    ],
    "interaction": {
      "version": "1.0",
      "mode": "external_steps"
    }
  },
  "turn": {
    "input_id": "input-1",
    "turn_id": "turn-1",
    "expected_revision": 0,
    "messages": [
      {
        "role": "user",
        "content": "first"
      }
    ]
  },
  "reply": {
    "input_id": "result-1",
    "turn_id": "turn-1",
    "batch_id": "batch-1",
    "expected_revision": 1,
    "results": [
      {
        "call_id": "call-1",
        "content": "tool result",
        "is_error": false
      }
    ]
  },
  "cases": [
    {
      "name": "conversation_input",
      "kind": "conversation_input",
      "value": {
        "input_id": "input-1",
        "turn_id": "turn-1",
        "expected_revision": 0,
        "messages": [
          {
            "role": "user",
            "content": "first"
          }
        ]
      },
      "error": null
    },
    {
      "name": "conversation_tool_response",
      "kind": "conversation_tool_response",
      "value": {
        "input_id": "result-1",
        "turn_id": "turn-1",
        "batch_id": "batch-1",
        "expected_revision": 1,
        "results": [
          {
            "call_id": "call-1",
            "content": "tool result",
            "is_error": false
          }
        ]
      },
      "error": null
    },
    {
      "name": "interaction_config",
      "kind": "interaction_config",
      "value": {
        "version": "1.0",
        "mode": "external_steps"
      },
      "error": null
    },
    {
      "name": "conversation_message",
      "kind": "conversation_message",
      "value": {
        "role": "tool",
        "content": "result",
        "call_id": "c1"
      },
      "error": null
    },
    {
      "name": "tool without call ID",
      "kind": "conversation_message",
      "value": {
        "role": "tool",
        "content": "result"
      },
      "error": "INVALID_MESSAGE"
    },
    {
      "name": "user with tool calls",
      "kind": "conversation_message",
      "value": {
        "role": "user",
        "content": "text",
        "tool_calls": []
      },
      "error": "INVALID_MESSAGE"
    },
    {
      "name": "negative revision",
      "kind": "conversation_input",
      "value": {
        "input_id": "input-1",
        "turn_id": "turn-1",
        "expected_revision": -1,
        "messages": [
          {
            "role": "user",
            "content": "first"
          }
        ]
      },
      "error": "INVALID_MESSAGE"
    },
    {
      "name": "untyped tool result",
      "kind": "conversation_tool_response",
      "value": {
        "input_id": "result-1",
        "turn_id": "turn-1",
        "batch_id": "batch-1",
        "expected_revision": 1,
        "results": [
          {
            "call_id": "call-1",
            "content": "result"
          }
        ]
      },
      "error": "INVALID_MESSAGE"
    },
    {
      "name": "single turn does not ignore history",
      "kind": "interaction_config",
      "value": {
        "version": "1.0",
        "mode": "single_turn",
        "initial_history": []
      },
      "error": "INVALID_MESSAGE"
    }
  ]
}
