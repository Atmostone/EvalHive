{
  "protocol_version": "1.0",
  "id": "example.fake",
  "version": "0.1.0",
  "display_name": "External fake connector",
  "entrypoint": [
    "python",
    "connector.py"
  ],
  "image": "evalhive-fake:0.1.0",
  "config_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "prefix": {
        "type": "string"
      },
      "wait": {
        "type": "boolean"
      },
      "fail": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "capabilities": {
    "feedback": "native",
    "abort": "native",
    "approval": "unsupported",
    "conversation": "native",
    "external_tool_execution": "emulated",
    "turn.submit": "native",
    "tool.respond": "native",
    "session.close": "native"
  },
  "commands": {
    "feedback": {
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "abort": {
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "turn.submit": {
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "const": "user"
                },
                "content": {
                  "type": "string",
                  "maxLength": 262144
                }
              },
              "required": [
                "role",
                "content"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "input_id",
          "turn_id",
          "expected_revision",
          "messages"
        ],
        "additionalProperties": false
      }
    },
    "tool.respond": {
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "batch_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "results": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "#/$defs/conversation_tool_result"
            }
          }
        },
        "required": [
          "input_id",
          "turn_id",
          "batch_id",
          "expected_revision",
          "results"
        ],
        "additionalProperties": false,
        "$defs": {
          "conversation_tool_result": {
            "type": "object",
            "properties": {
              "call_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "content": {},
              "is_error": {
                "type": "boolean"
              }
            },
            "required": [
              "call_id",
              "content",
              "is_error"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "session.close": {
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "maxLength": 262144
          }
        },
        "required": [
          "input_id",
          "expected_revision",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  }
}
