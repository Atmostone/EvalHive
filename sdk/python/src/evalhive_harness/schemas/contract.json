        }
      },
      "required": [
        "turn_id",
        "input_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "session_waiting_input": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "revision"
      ],
      "additionalProperties": false
    },
    "conversation_tool_request": {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "input_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "calls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/conversation_tool_call"
          }
        }
      },
      "required": [
        "turn_id",
        "input_id",
        "revision",
        "message_id",
        "batch_id",
        "calls"
      ],
      "additionalProperties": false
    },
    "runtime_bundle": {
      "type": "object",
      "properties": {
        "bundle_version": {
          "const": "1.0"
        },
        "connector_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "connector_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "object",
          "properties": {
            "os": {
              "const": "linux"
            },
            "architecture": {
              "const": "amd64"
            },
            "libc": {
              "const": "glibc"
            }
          },
          "required": [
            "os",
            "architecture",
            "libc"
          ],
          "additionalProperties": false
        },
        "mount_path": {
          "const": "/evalhive-runtime"
        },
        "entrypoint": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "files": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 100000,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483648
              },
              "executable": {
                "type": "boolean"
              }
            },
            "required": [
              "sha256",
              "size",
              "executable"
            ],
            "additionalProperties": false
          }
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "stdout": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "argv",
              "stdout"
            ],
            "additionalProperties": false
          }
        },
        "excluded_paths": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "loader_wrappers": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "required": [
        "bundle_version",
        "connector_id",
        "connector_version",
        "platform",
        "mount_path",
        "entrypoint",
        "files",
        "probes"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/wire_message"
}
