{
  "protocol_version": "1.0",
  "id": "legacy-toolathlon",
  "version": "0.1.0",
  "display_name": "Legacy agent (Toolathlon)",
  "entrypoint": [
    "python",
    "/opt/connector/worker.py"
  ],
  "image": "evalhive-legacy-toolathlon:harness-0.1.0",
  "requirements": {
    "temporary": true,
    "model_api": "openai-compatible"
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "tools": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "bash",
            "file_write",
            "file_read",
            "search_knowledge_base"
          ]
        }
      },
      "mcp_credential_refs": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "memory_context": {
        "type": "string"
      },
      "temperature": {
        "type": [
          "number",
          "null"
        ]
      },
      "seed": {
        "type": [
          "integer",
          "null"
        ]
      },
      "benchmark_mode": {
        "type": "boolean"
      },
      "tool_injection": {
        "type": "string"
      },
      "pg_host": {
        "type": "string",
        "pattern": "^toolathlon_pg[a-zA-Z0-9_-]*$"
      }
    },
    "additionalProperties": false
  },
  "capabilities": {
    "abort": "emulated",
    "feedback": "emulated",
    "switch_model": "unsupported"
  },
  "commands": {
    "abort": {
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "feedback": {
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    }
  }
}
