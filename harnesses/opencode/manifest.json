{
  "protocol_version": "1.0",
  "id": "opencode",
  "version": "0.2.0",
  "display_name": "OpenCode",
  "entrypoint": [
    "node",
    "/opt/connector/dist/index.js"
  ],
  "image": "evalhive-opencode:1.19.5",
  "requirements": {
    "node": ">=22.19.0",
    "platform": "linux/amd64",
    "harness_version": "1.19.5",
    "model_api": "openai-compatible",
    "environment_images": {
      "toolathlon": "evalhive-opencode-toolathlon:1.19.5"
    },
    "runtime_bundle": {
      "image": "evalhive-opencode-bundle:1.19.5",
      "path": "/bundle"
    }
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiTimeoutSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 120,
        "default": 30,
        "description": "Budget for native server observations; the attempt deadline still applies."
      },
      "contextWindow": {
        "type": "integer",
        "minimum": 128,
        "maximum": 2000000,
        "default": 128000
      },
      "maxOutputTokens": {
        "type": "integer",
        "minimum": 1,
        "maximum": 128000,
        "default": 8192
      },
      "autoCompaction": {
        "type": "boolean",
        "default": true
      },
      "temperature": {
        "type": "number",
        "minimum": 0,
        "maximum": 2
      },
      "reasoning": {
        "type": "boolean",
        "default": false
      },
      "topP": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "permissionMode": {
        "enum": [
          "allow",
          "ask",
          "deny"
        ],
        "default": "allow"
      }
    }
  },
  "capabilities": {
    "abort": "native",
    "feedback": "native",
    "approval": "native",
    "conversation": "native",
    "external_tool_execution": "emulated",
    "conversation_history": "native",
    "turn.submit": "native",
    "tool.respond": "native",
    "session.close": "native"
  },
  "commands": {
    "abort": {
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "feedback": {
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "approval": {
      "input_schema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "once",
              "always",
              "reject"
            ]
          }
        },
        "required": [
          "request_id",
          "decision"
        ],
        "additionalProperties": false
      }
    },
    "turn.submit": {
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "const": "user"
                },
                "content": {
                  "type": "string",
                  "maxLength": 262144
                }
              },
              "required": [
                "role",
                "content"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "input_id",
          "turn_id",
          "expected_revision",
          "messages"
        ],
        "additionalProperties": false
      }
    },
    "tool.respond": {
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "batch_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "results": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "#/$defs/conversation_tool_result"
            }
          }
        },
        "required": [
          "input_id",
          "turn_id",
          "batch_id",
          "expected_revision",
          "results"
        ],
        "additionalProperties": false,
        "$defs": {
          "conversation_tool_result": {
            "type": "object",
            "properties": {
              "call_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "content": {},
              "is_error": {
                "type": "boolean"
              }
            },
            "required": [
              "call_id",
              "content",
              "is_error"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "session.close": {
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "maxLength": 262144
          }
        },
        "required": [
          "input_id",
          "expected_revision",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  }
}
