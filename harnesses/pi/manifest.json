{
  "protocol_version": "1.0",
  "id": "pi",
  "version": "0.2.1",
  "display_name": "Pi",
  "entrypoint": [
    "node",
    "/opt/connector/dist/index.js"
  ],
  "image": "evalhive-pi:1.5.0",
  "requirements": {
    "node": ">=22.19.0",
    "harness_version": "1.5.0",
    "model_api": "openai-compatible",
    "environment_images": {
      "toolathlon": "evalhive-pi-toolathlon:1.5.0"
    },
    "runtime_bundle": {
      "image": "evalhive-pi-bundle:1.5.0",
      "path": "/bundle"
    }
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "thinkingLevel": {
        "type": "string",
        "enum": [
          "off",
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "default": "off"
      },
      "contextWindow": {
        "type": "integer",
        "minimum": 128,
        "maximum": 2000000,
        "default": 128000
      },
      "maxOutputTokens": {
        "type": "integer",
        "minimum": 1,
        "maximum": 128000,
        "default": 8192
      },
      "autoCompaction": {
        "type": "boolean",
        "default": true
      },
      "maxRetries": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5,
        "default": 2
      },
      "retryBaseDelayMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30000,
        "default": 200
      },
      "temperature": {
        "type": "number",
        "minimum": 0,
        "maximum": 2
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "reasoning": {
        "type": "boolean",
        "default": false
      },
      "compat": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "supportsUsageInStreaming": {
            "type": "boolean"
          },
          "supportsReasoningEffort": {
            "type": "boolean"
          },
          "maxTokensField": {
            "enum": [
              "max_tokens",
              "max_completion_tokens"
            ]
          },
          "thinkingFormat": {
            "enum": [
              "deepseek",
              "openai",
              "qwen",
              "qwen-chat-template",
              "zai"
            ]
          }
        }
      },
      "compaction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reserveTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1999999,
            "default": 16384
          },
          "keepRecentTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000000,
            "default": 20000
          }
        }
      }
    }
  },
  "capabilities": {
    "abort": "native",
    "feedback": "native",
    "conversation": "native",
    "external_tool_execution": "emulated",
    "conversation_history": "native",
    "turn.submit": "native",
    "tool.respond": "native",
    "session.close": "native",
    "model_gateway": "native"
  },
  "commands": {
    "abort": {
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "feedback": {
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "turn.submit": {
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "const": "user"
                },
                "content": {
                  "type": "string",
                  "maxLength": 262144
                }
              },
              "required": [
                "role",
                "content"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "input_id",
          "turn_id",
          "expected_revision",
          "messages"
        ],
        "additionalProperties": false
      }
    },
    "tool.respond": {
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "turn_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "batch_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "results": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "$ref": "#/$defs/conversation_tool_result"
            }
          }
        },
        "required": [
          "input_id",
          "turn_id",
          "batch_id",
          "expected_revision",
          "results"
        ],
        "additionalProperties": false,
        "$defs": {
          "conversation_tool_result": {
            "type": "object",
            "properties": {
              "call_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "content": {},
              "is_error": {
                "type": "boolean"
              }
            },
            "required": [
              "call_id",
              "content",
              "is_error"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "session.close": {
      "input_schema": {
        "type": "object",
        "properties": {
          "input_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "maxLength": 262144
          }
        },
        "required": [
          "input_id",
          "expected_revision",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  }
}
